OLLAMA_HOST=http://127.0.0.1:11434
API_HOST=127.0.0.1
API_PORT=8000
DEFAULT_CHAT_MODEL=gemma4:e4b
DEFAULT_EMBED_MODEL=bge-m3:latest
OLLAMA_REQUEST_TIMEOUT=600
CORS_ORIGIN=*
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-local-master-key
LITELLM_TIMEOUT=2000
ZHIPU_API_KEY=replace-with-zhipu-cn-key
# Optional: set ZAI_API_KEY directly if you do not use scripts/start_litellm.sh
ZAI_API_KEY=
MINIMAX_API_KEY=replace-with-minimax-key

WEB_PROXY_URL=
WEB_PROXY_REQUIRED=false
WEB_SEARCH_ENGLISH_ONLY=false
WEB_SEARCH_LANGUAGE=
WEB_SEARCH_COUNTRY=
PROVIDER_WEB_SEARCH_ENABLED=true
PROVIDER_WEB_SEARCH_MODEL=glm-5.1-standard
PROVIDER_WEB_SEARCH_ENGINE=search-prime
PROVIDER_WEB_SEARCH_RECENCY_FILTER=noLimit
PROVIDER_WEB_SEARCH_CONTENT_SIZE=medium
PROVIDER_WEB_SEARCH_MAX_RESULTS=5

AGENT_AUDIT_LOG_ENABLED=true
AGENT_AUDIT_LOG_PATH=logs/agent_runs.jsonl

WRDS_API_ENABLED=true
# Optional. If set, direct /wrds/* API calls must include x-wrds-api-key or Authorization: Bearer.
WRDS_API_TOKEN=
PLATFORM_CONFIG_PATH=.local/platform_config.json

ORCHESTRATOR_MODEL=glm-5.1
MEMORY_AGENT_MODEL=glm-5.1
EXECUTOR_MODEL=minimax-m2.7
RESEARCH_AGENT_MODEL=glm-5.1
RESEARCH_AGENT_FALLBACK_MODEL=minimax-m2.7
QUANT_AGENT_MODEL=glm-5.1
QUANT_AGENT_FALLBACK_MODEL=minimax-m2.7
DOMAIN_EXPERT_MODEL=glm-5.1
CIO_AGENT_MODEL=glm-5.1
DATA_AUDITOR_AGENT_MODEL=glm-5.1
FUNDAMENTAL_ANALYST_AGENT_MODEL=glm-5.1
QUANT_RESEARCH_AGENT_MODEL=glm-5.1
INDUSTRY_STRATEGY_AGENT_MODEL=glm-5.1
MARKET_EXECUTION_AGENT_MODEL=minimax-m2.7
RISK_MANAGER_AGENT_MODEL=glm-5.1
RED_TEAM_AGENT_MODEL=minimax-m2.7
COMMITTEE_MEMBER_FALLBACK_MODEL=minimax-m2.7
COMMITTEE_CHALLENGE_MODEL=minimax-m2.7
INVESTMENT_COMMITTEE_MODEL=glm-5.1
INVESTMENT_COMMITTEE_FALLBACK_MODEL=minimax-m2.7
CRITIC_MODEL=minimax-m2.7
WRITER_MODEL=minimax-m2.7
FINAL_JUDGE_MODEL=glm-5.1
GLM_FALLBACK_MODELS=glm-5.1-standard,minimax-m2.7
MINIMAX_FALLBACK_MODELS=glm-5.1-standard,glm-5.1
DEFAULT_FALLBACK_MODELS=
# Keep false so Agent Metrics can record node-level fallback transparently.
MODEL_GATEWAY_INTERNAL_FALLBACK=false
