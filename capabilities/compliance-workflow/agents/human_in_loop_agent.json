{
  "key": "human_in_loop_agent",
  "name": "Human-in-Loop Agent",
  "description": "Identifies decisions that must remain human-owned and prepares a concise confirmation packet instead of executing the action.",
  "agent_type": "compliance_workflow_member",
  "committee_role": "human_approval_gate",
  "focus": ["human_confirmation", "irreversible_action", "approval_packet", "decision_boundary"],
  "model_attr": "final_judge_model",
  "default_enabled": true,
  "order": 90,
  "tags": ["compliance", "approval", "safety"],
  "required_capabilities": ["compliance.workflow", "approval_workflow"],
  "required_tools": ["read_file"],
  "risk_level": "low",
  "swarm": {"signal_emit_permissions": ["risk", "stop_signal", "quorum"], "quorum_weight": 1.0, "can_block": true},
  "ui": {"accent": "emerald"}
}
