{
  "id": "data-analysis",
  "name": "Deterministic Data Analysis",
  "version": "0.1.0",
  "description": "Analyze user-provided structured data with deterministic calculations and guarded narrative synthesis.",
  "capability_types": ["data_analysis", "skill:data-analysis"],
  "permissions": ["skill:read", "data:read", "tool:deterministic-read", "model:chat"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "deny_by_default",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": [],
  "protocol": {
    "version": "0.1.0",
    "intents": ["data_analysis"],
    "intent_keywords": {
      "data_analysis": [
        "csv",
        "xlsx",
        "spreadsheet",
        "dataset",
        "data analysis",
        "analyze data",
        "summary statistics",
        "statistics",
        "distribution",
        "aggregate",
        "calculation",
        "表格",
        "数据分析",
        "统计"
      ]
    },
    "required_capability_types": ["data_analysis", "skill:data-analysis"],
    "targets": [
      {
        "target": "metric:data_quality",
        "default_pressure": 0.8,
        "keywords": ["csv", "xlsx", "spreadsheet", "dataset", "missing values", "data quality", "表格", "数据"],
        "summary": "Assess the provided data for completeness and quality."
      },
      {
        "target": "artifact:data_summary",
        "default_pressure": 0.82,
        "keywords": ["summary statistics", "statistics", "distribution", "aggregate", "分析", "统计"],
        "summary": "Produce deterministic summary statistics and analysis notes."
      },
      {
        "target": "gate:analysis_reproducibility",
        "default_pressure": 0.72,
        "keywords": ["reproducible", "formula", "calculation", "deterministic", "quality"],
        "summary": "Keep analysis reproducible and grounded in available data."
      }
    ],
    "candidates": [
      {"candidate": "candidate:data:complete", "target": "artifact:data_summary"},
      {"candidate": "candidate:data:needs_more_data", "target": "metric:data_quality", "safe_fallback": true}
    ],
    "quorum_policy": {
      "candidates": ["candidate:data:complete", "candidate:data:needs_more_data"],
      "candidate_fallback": "candidate:data:needs_more_data",
      "max_swarm_rounds": 2
    },
    "tool_policy": {
      "allowed_tool_targets": ["tool:list_files", "tool:read_file"],
      "required_permissions": ["skill:read", "data:read", "tool:deterministic-read", "model:chat"],
      "risk_level": "low"
    },
    "output_policy": {
      "allowed_output_modes": ["data_summary", "quality_notes"],
      "writer_can_create_facts": false
    }
  },
  "tools": ["list_files", "read_file"],
  "skills": ["data-analysis"],
  "data_packages": ["user_dataset", "summary_statistics", "data_quality"],
  "entrypoints": {},
  "ui": {
    "icon": "chart",
    "accent": "indigo"
  }
}
