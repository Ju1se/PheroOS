{
  "id": "document-writing",
  "name": "Document Writing",
  "version": "0.1.0",
  "description": "Draft, revise, structure, and critique long-form documents without requiring external data access.",
  "capability_types": ["document_writing", "skill:document-writing"],
  "permissions": ["skill:read", "model:chat"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "deny_by_default",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": [],
  "protocol": {
    "version": "0.1.0",
    "intents": ["document_writing"],
    "intent_keywords": {
      "document_writing": [
        "document",
        "draft",
        "memo",
        "proposal",
        "rewrite",
        "summarize",
        "structure",
        "tone",
        "文档",
        "报告",
        "撰写",
        "改写",
        "润色",
        "总结"
      ]
    },
    "required_capability_types": ["document_writing", "skill:document-writing"],
    "targets": [
      {
        "target": "artifact:document_draft",
        "default_pressure": 0.82,
        "keywords": ["draft", "document", "memo", "proposal", "rewrite", "summarize", "撰写", "改写", "总结"],
        "summary": "Produce the requested document artifact."
      },
      {
        "target": "gate:document_quality",
        "default_pressure": 0.74,
        "keywords": ["quality", "structure", "tone", "clarity", "review", "critique", "润色"],
        "summary": "Check document structure, tone, and requested constraints."
      }
    ],
    "candidates": [
      {"candidate": "candidate:document:ready", "target": "artifact:document_draft"},
      {"candidate": "candidate:document:revise", "target": "gate:document_quality", "safe_fallback": true}
    ],
    "quorum_policy": {
      "candidates": ["candidate:document:ready", "candidate:document:revise"],
      "candidate_fallback": "candidate:document:revise",
      "max_swarm_rounds": 2
    },
    "tool_policy": {
      "required_permissions": ["skill:read", "model:chat"],
      "risk_level": "low"
    },
    "output_policy": {
      "allowed_output_modes": ["document_draft", "revision_notes"],
      "writer_can_create_facts": false
    }
  },
  "tools": [],
  "skills": ["document-writing"],
  "data_packages": [],
  "entrypoints": {},
  "ui": {
    "icon": "document",
    "accent": "amber"
  }
}
