{
  "id": "evidence-research",
  "name": "Evidence Research",
  "version": "0.1.0",
  "description": "Run claim-first research with source retrieval, source quality rating, citation audit, contradiction mapping, and claim-evidence graph production.",
  "capability_types": [
    "evidence.research",
    "skill:evidence-research",
    "citation_audit",
    "claim_decomposition",
    "source_quality",
    "claim_evidence_graph"
  ],
  "permissions": ["skill:read", "data:read", "tool:deterministic-read", "network:approved-provider", "model:chat"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "approved_provider_only",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": ["model_provider"],
  "required_connections": ["model_provider"],
  "tools": ["web_search", "fetch_url", "approved_source_fetch", "provider_web_search"],
  "skills": ["evidence-research"],
  "data_packages": [
    "research_questions",
    "atomic_claims",
    "source_candidates",
    "source_quality_scores",
    "claim_evidence_graph",
    "citation_audit",
    "contradiction_map"
  ],
  "agents_path": "agents",
  "entrypoints": {
    "workflow": "workflow.py:build_workflow_descriptor",
    "data_contract": "data_contract.py:build_data_contract_descriptor",
    "evidence_adapter": "evidence_adapter.py:build_evidence_adapter_descriptor",
    "ui_schema": "ui.schema.json"
  },
  "protocol": {
    "version": "1.0.0",
    "intents": ["evidence_research"],
    "intent_keywords": {
      "evidence_research": [
        "evidence",
        "citation",
        "cite",
        "claim",
        "source quality",
        "contradiction",
        "fact check",
        "verify",
        "verification",
        "provenance",
        "research memo",
        "literature",
        "source retrieval",
        "claim evidence graph",
        "collective decision",
        "multi-agent",
        "swarm",
        "pheromone",
        "stigmergy",
        "证据",
        "引用",
        "出处",
        "来源质量",
        "事实核查",
        "核验",
        "验证",
        "矛盾",
        "证伪",
        "群体智能",
        "群体决策",
        "蚁群",
        "蜂群"
      ]
    },
    "required_capability_types": ["evidence.research", "skill:evidence-research"],
    "required_protocols": ["citation_audit", "evidence_gate", "contradiction_map", "stop_signal", "quorum"],
    "allowed_signal_types": ["evidence", "risk", "negative", "quorum", "stop_signal", "policing"],
    "targets": [
      {
        "target": "research:claim_decomposition",
        "aliases": ["claim_decomposition", "atomic_claims"],
        "demand_strength": 0.88,
        "keywords": ["claim", "atomic", "scope", "机制", "群体决策"],
        "summary": "Decompose research questions into independently verifiable claims."
      },
      {
        "target": "research:source_retrieval",
        "aliases": ["source_retrieval", "source_candidates"],
        "demand_strength": 0.86,
        "keywords": ["source", "retrieval", "coverage", "literature", "论文", "来源"],
        "summary": "Recruit source retrieval before synthesis."
      },
      {
        "target": "metric:research_source_quality",
        "aliases": ["research:source_quality", "source_quality"],
        "demand_strength": 0.84,
        "keywords": ["source_quality", "provenance", "authority", "recency", "来源质量"],
        "summary": "Rate source provenance and authority before claims are promoted."
      },
      {
        "target": "gate:research_evidence_gate",
        "aliases": ["research:evidence_gate", "evidence_gate", "claim_support"],
        "demand_strength": 0.9,
        "keywords": ["evidence", "claim_evidence_graph", "support_strength", "证据"],
        "summary": "Promote only evidence-linked claims into final synthesis."
      },
      {
        "target": "issue:research_contradiction",
        "aliases": ["research:contradiction", "contradiction", "contested_source"],
        "demand_strength": 0.72,
        "keywords": ["contradiction", "counterevidence", "uncertainty", "矛盾", "反例"],
        "summary": "Surface contradictions and limits before generalizing evidence."
      },
      {
        "target": "gate:research_citation_audit",
        "aliases": ["research:citation_audit", "citation_audit", "fake_citation"],
        "demand_strength": 0.76,
        "keywords": ["citation", "quote", "unsupported", "引用"],
        "summary": "Audit citation support for final claims."
      }
    ],
    "recovery_protocols": [
      {
        "id": "approved_source_evidence_recovery",
        "hook": "runtime.workflows.evidence_research:evidence_recovery_node",
        "targets": [
          {
            "target": "research:source_retrieval",
            "demand_strength": 0.92,
            "keywords": ["source", "full_text", "approved_source_fetch"]
          },
          {
            "target": "gate:research_citation_audit",
            "demand_strength": 0.86,
            "keywords": ["citation", "verification"]
          }
        ],
        "max_rounds": 3,
        "retry_tools": ["approved_source_fetch"],
        "allowed_agent_roles": ["source_retriever", "citation_auditor", "evidence_steward"],
        "allowed_capability_tags": ["retrieval", "sources", "citations", "evidence-graph"],
        "recovery_success_condition": "context.full_text_count > 0",
        "recovery_failure_candidate": "candidate:synthesis:insufficient_evidence",
        "recruitment": "target_pressure"
      }
    ],
    "candidates": [
      {
        "candidate": "candidate:synthesis:publish",
        "label": "Publish synthesis",
        "target": "gate:research_evidence_gate",
        "required_evidence_targets": ["gate:research_evidence_gate", "gate:research_citation_audit"]
      },
      {
        "candidate": "candidate:synthesis:preliminary",
        "label": "Preliminary with caveats",
        "target": "gate:research_evidence_gate",
        "required_evidence_targets": ["gate:research_evidence_gate"]
      },
      {
        "candidate": "candidate:synthesis:insufficient_evidence",
        "label": "Insufficient evidence",
        "target": "gate:research_evidence_gate",
        "safe_fallback": true
      }
    ],
    "quorum_policy": {
      "candidate_type": "research_synthesis",
      "candidates": [
        "candidate:synthesis:publish",
        "candidate:synthesis:preliminary",
        "candidate:synthesis:insufficient_evidence"
      ],
      "candidate_fallback": "candidate:synthesis:insufficient_evidence",
      "evidence_coverage_weight": 0.45,
      "source_independence_weight": 0.25,
      "contradiction_penalty": 0.2,
      "max_swarm_rounds": 3
    },
    "evidence_policy": {
      "claim_types": ["research_synthesis_claim", "citation_claim"],
      "evidence_node_types": ["atomic_claim", "source_candidate", "claim_evidence_graph", "citation_audit"],
      "required_evidence_for_final_claims": ["gate:research_evidence_gate", "gate:research_citation_audit"],
      "allow_caveated_claim_without_evidence": true,
      "source_independence_required": true,
      "citation_required": true,
      "raw_data_allowed_in_final": false,
      "unsupported_claim_action": "caveat_or_block"
    },
    "tool_policy": {
      "allowed_tool_targets": ["tool:web_search", "tool:fetch_url", "tool:approved_source_fetch", "tool:provider_web_search"],
      "required_permissions": ["skill:read", "data:read", "tool:deterministic-read", "network:approved-provider", "model:chat"],
      "required_connections": ["model_provider"],
      "risk_level": "low",
      "quarantine_external_outputs": true,
      "tool_failure_recovery": {
        "web_search": "approved_source_evidence_recovery",
        "fetch_url": "approved_source_evidence_recovery"
      }
    },
    "output_policy": {
      "allowed_output_modes": ["publish_synthesis", "preliminary_with_caveats", "insufficient_evidence"],
      "required_caveats": ["State uncertainty when source coverage or citation support is incomplete."],
      "final_claim_evidence_required": true,
      "defect_memo_on_block": true,
      "writer_can_create_facts": false,
      "final_judge_required_checks": ["citation_audit", "contradiction_map", "evidence_gate"]
    },
    "agent_selection_policy": {
      "required_roles": ["claim_decomposer", "source_retriever", "source_quality_rater", "evidence_steward"],
      "optional_roles": ["citation_auditor", "contradiction_mapper"],
      "activation_threshold": 0.5,
      "fallback_strategy": "protocol_then_legacy"
    },
    "stop_signal_policy": {
      "authority_level_required": 3,
      "blocking_lifetime": "until_resolved",
      "blocked_actions": ["writer:confirmed_claim", "final_judge:publish_without_citation_audit"],
      "action_markers": [
        {
          "action": "writer:confirmed_claim",
          "phrases": ["已证实", "确定证明", "无争议", "confirmed", "proves that", "definitively"]
        },
        {
          "action": "final_judge:publish_without_citation_audit",
          "phrases": ["publish without citation audit", "citation audit not required", "approve uncited claim"]
        }
      ],
      "rules": [
        {
          "id": "evidence_gate_blocks_confirmed_claims",
          "trigger_targets": ["gate:research_evidence_gate", "gate:research_citation_audit"],
          "blocked_actions": ["writer:confirmed_claim", "final_judge:publish_without_citation_audit"]
        }
      ]
    }
  },
  "ui": {
    "icon": "evidence-graph",
    "accent": "cyan"
  }
}
