{
  "id": "public-financial-data",
  "name": "Public Financial Data",
  "version": "0.1.0",
  "description": "Use fixed, read-only public financial data adapters for SEC EDGAR filings/facts, FRED macro series, Stooq/yfinance market prices, and Kenneth French factor datasets.",
  "capability_types": [
    "public_financial_data",
    "supplemental_financial_fundamentals",
    "filings",
    "macro_data",
    "market_prices",
    "asset_pricing_factors"
  ],
  "permissions": ["network:approved-provider", "data:read", "tool:deterministic-read"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "approved_provider_only",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [
    "www.sec.gov",
    "data.sec.gov",
    "api.stlouisfed.org",
    "stooq.com",
    "mba.tuck.dartmouth.edu",
    "query1.finance.yahoo.com",
    "query2.finance.yahoo.com"
  ],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": [],
  "required_connections": [],
  "tools": [
    "sec_company_search",
    "sec_company_facts",
    "sec_recent_filings",
    "fred_series",
    "market_price_history",
    "kenneth_french_factors"
  ],
  "skills": ["public-financial-data"],
  "data_packages": [
    "sec_company_identity",
    "sec_company_facts",
    "sec_recent_filings",
    "fred_macro_series",
    "stooq_market_prices",
    "yfinance_market_prices_optional",
    "kenneth_french_factors"
  ],
  "entrypoints": {
    "tool_module": "tools.public_financial_tools:PublicFinancialDataTools"
  },
  "ui": {
    "icon": "public-database",
    "accent": "blue"
  }
