{
  "id": "value-investing-research",
  "name": "Value Investing Research",
  "version": "0.1.0",
  "description": "Run evidence-first investment analysis with data gates, valuation discipline, committee debate, critic review, and guarded writing.",
  "capability_types": [
    "skill:value-investing-research",
    "investment.research",
    "investment_committee",
    "portfolio.review",
    "valuation",
    "valuation_analysis"
  ],
  "permissions": ["skill:read", "data:read"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "deny_by_default",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": [],
  "tools": [],
  "skills": ["value-investing-research"],
  "data_packages": [],
  "agents_path": "agents",
  "entrypoints": {
    "workflow": "capabilities/value-investing-research/workflow.py:build_workflow_descriptor",
    "runtime_support": "capabilities/value-investing-research/support.py",
    "data_contract": "capabilities/value-investing-research/data_contract.py:build_data_contract_descriptor",
    "evidence_adapter": "capabilities/value-investing-research/evidence_adapter.py:build_evidence_adapter_descriptor",
    "ui_schema": "capabilities/value-investing-research/ui.schema.json"
  },
  "protocol": {
    "version": "1.0.0",
    "intents": ["investment_analysis", "financial_data_retrieval", "portfolio_review"],
    "intent_keywords": {
      "investment_analysis": [
        "investment",
        "value investing",
        "valuation",
        "fundamental",
        "financial health",
        "earnings quality",
        "cash flow",
        "moat",
        "capital allocation",
        "target price",
        "buy",
        "sell",
        "hold",
        "投资",
        "价值投资",
        "估值",
        "股票",
        "股价",
        "基本面",
        "财务",
        "财报",
        "现金流",
        "护城河",
        "买入",
        "卖出",
        "持有"
      ],
      "financial_data_retrieval": [
        "wrds",
        "compustat",
        "crsp",
        "ibes",
        "financial data",
        "company financials",
        "fundamentals data",
        "metric registry",
        "data gate",
        "sec edgar",
        "fred",
        "stooq",
        "kenneth french",
        "fama french",
        "专业数据",
        "专业信息",
        "财务数据",
        "财报数据",
        "基本面数据"
      ],
      "portfolio_review": [
        "portfolio",
        "allocation",
        "position sizing",
        "rebalance",
        "holdings",
        "concentration",
        "downside",
        "suitability",
        "组合",
        "持仓",
        "仓位",
        "配置",
        "再平衡"
      ]
    },
    "required_capability_types": ["financial_fundamentals", "professional_financial_database"],
    "required_capability_types_by_intent": {
      "investment_analysis": ["financial_fundamentals", "professional_financial_database"],
      "financial_data_retrieval": ["financial_fundamentals", "professional_financial_database"],
      "portfolio_review": []
    },
    "targets": [
      {
        "target": "decision:formal_valuation",
        "target_type": "decision",
        "description": "Decide whether formal valuation conclusions are allowed.",
        "aliases": [
          "formal_valuation",
          "formal valuation",
          "formal-valuation",
          "decision_formal_valuation",
          "decision.formal_valuation",
          "decision:valuation",
          "valuation",
          "target_price",
          "target price",
          "investment_recommendation",
          "investment recommendation",
          "recommendation"
        ],
        "required": true,
        "default_pressure": 0.92,
        "keywords": ["valuation", "financial", "quant", "data", "risk"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "allowed_signal_types": ["evidence", "risk", "stop_signal", "data_contract", "quorum"]
      },
      {
        "target": "decision:report_publication",
        "target_type": "decision",
        "description": "Decide whether the investment report may be published.",
        "aliases": [
          "report_publication",
          "report publication",
          "report-publication",
          "decision_report_publication",
          "decision.report_publication",
          "publication",
          "final_report",
          "final report",
          "report"
        ],
        "required": true,
        "default_pressure": 0.9,
        "keywords": ["publication", "report", "writer", "final_judge"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "allowed_signal_types": ["stop_signal", "policing", "quarantine", "data_contract"]
      },
      {
        "target": "gate:data_gate",
        "target_type": "gate",
        "description": "Require metric registry and data-gate approval before formal valuation.",
        "required": true,
        "default_pressure": 0.92,
        "keywords": ["data_gate", "metric_registry", "wrds", "audit"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "allowed_signal_types": ["data_contract", "evidence", "risk", "stop_signal"]
      },
      {
        "target": "evidence:financial_metrics",
        "target_type": "evidence",
        "description": "Require report-ready financial metrics sourced from the metric registry.",
        "required": true,
        "default_pressure": 0.86,
        "keywords": ["metric_registry", "financial_metrics", "wrds", "evidence"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "allowed_signal_types": ["evidence", "data_contract", "tool_health"]
      },
      {
        "target": "tool:web_search",
        "target_type": "tool",
        "description": "Public web research is blocked in WRDS-only investment mode unless source policy explicitly permits it.",
        "required": false,
        "default_pressure": 0.6,
        "keywords": ["web", "source_policy", "wrds_only"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "allowed_signal_types": ["stop_signal", "tool_health"]
      },
      {
        "target": "decision:portfolio_review",
        "target_type": "decision",
        "description": "Review allocation, concentration, and position-sizing decisions.",
        "required": true,
        "default_pressure": 0.78,
        "keywords": ["portfolio", "allocation", "position", "rebalance", "risk"],
        "compatible_intents": ["portfolio_review"],
        "allowed_signal_types": ["risk", "quorum", "evidence"]
      },
      {
        "target": "constraint:portfolio_risk",
        "target_type": "constraint",
        "description": "Constrain portfolio review by concentration, downside, and suitability risks.",
        "required": true,
        "default_pressure": 0.74,
        "keywords": ["concentration", "downside", "position sizing", "suitability"],
        "compatible_intents": ["portfolio_review"],
        "allowed_signal_types": ["risk", "stop_signal", "evidence"]
      },
      {
        "target": "candidate:investment:buy",
        "target_type": "candidate",
        "description": "Evaluate the buy candidate.",
        "required": false,
        "default_pressure": 0.7,
        "keywords": ["buy", "upside", "conviction"],
        "compatible_intents": ["investment_analysis"]
      },
      {
        "target": "candidate:investment:watch",
        "target_type": "candidate",
        "description": "Evaluate the watch candidate.",
        "required": false,
        "default_pressure": 0.72,
        "keywords": ["watch", "uncertainty", "wait"],
        "compatible_intents": ["investment_analysis"]
      },
      {
        "target": "candidate:investment:avoid",
        "target_type": "candidate",
        "description": "Evaluate the avoid candidate.",
        "required": false,
        "default_pressure": 0.7,
        "keywords": ["avoid", "risk", "downside"],
        "compatible_intents": ["investment_analysis"]
      },
      {
        "target": "candidate:investment:sell",
        "target_type": "candidate",
        "description": "Evaluate the sell candidate.",
        "required": false,
        "default_pressure": 0.68,
        "keywords": ["sell", "downside", "risk"],
        "compatible_intents": ["investment_analysis"]
      },
      {
        "target": "candidate:investment:insufficient_data",
        "target_type": "candidate",
        "description": "Commit insufficient-data when valuation evidence is not enough.",
        "required": false,
        "default_pressure": 0.84,
        "keywords": ["data", "gap", "insufficient", "audit"],
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"]
      }
    ],
    "candidates": [
      {
        "candidate": "candidate:investment:buy",
        "label": "Buy",
        "target": "decision:formal_valuation",
        "compatible_intents": ["investment_analysis"],
        "blocked_by_targets": ["decision:formal_valuation", "decision:report_publication", "gate:data_gate"],
        "required_evidence_targets": ["evidence:financial_metrics"],
        "default_priority": 0.7
      },
      {
        "candidate": "candidate:investment:watch",
        "label": "Watch",
        "target": "decision:formal_valuation",
        "compatible_intents": ["investment_analysis"],
        "blocked_by_targets": ["decision:formal_valuation", "decision:report_publication", "gate:data_gate"],
        "required_evidence_targets": ["evidence:financial_metrics"],
        "default_priority": 0.72
      },
      {
        "candidate": "candidate:investment:avoid",
        "label": "Avoid",
        "target": "decision:formal_valuation",
        "compatible_intents": ["investment_analysis"],
        "blocked_by_targets": ["decision:formal_valuation", "decision:report_publication", "gate:data_gate"],
        "required_evidence_targets": ["evidence:financial_metrics"],
        "default_priority": 0.68
      },
      {
        "candidate": "candidate:investment:sell",
        "label": "Sell",
        "target": "decision:formal_valuation",
        "compatible_intents": ["investment_analysis"],
        "blocked_by_targets": ["decision:formal_valuation", "decision:report_publication", "gate:data_gate"],
        "required_evidence_targets": ["evidence:financial_metrics"],
        "default_priority": 0.64
      },
      {
        "candidate": "candidate:investment:insufficient_data",
        "label": "Insufficient Data",
        "target": "decision:formal_valuation",
        "compatible_intents": ["investment_analysis", "financial_data_retrieval"],
        "safe_fallback": true,
        "default_priority": 0.9
      }
    ],
    "quorum_policy": {
      "candidates": [
        "candidate:investment:buy",
        "candidate:investment:watch",
        "candidate:investment:avoid",
        "candidate:investment:sell",
        "candidate:investment:insufficient_data"
      ],
      "candidate_type": "investment_decision",
      "quorum_threshold": 0.6,
      "min_independent_sources": 1,
      "evidence_coverage_weight": 0.35,
      "source_independence_weight": 0.25,
      "unresolved_risk_penalty": 0.25,
      "stop_signal_penalty": 0.15,
      "candidate_fallback": "candidate:investment:insufficient_data",
      "force_fallback_when_blocked": true,
      "max_swarm_rounds": 3
    },
    "stop_signal_policy": {
      "blocked_targets": ["decision:formal_valuation", "decision:report_publication", "gate:data_gate", "constraint:data_source_policy"],
      "blocking_authority_required": 3,
      "blocking_lifetime": "until_resolved",
      "applies_to_tools": true,
      "applies_to_writer": true,
      "applies_to_final_judge": true,
      "applies_to_candidates": true,
      "blocked_actions": ["writer:formal_valuation", "final_judge:investment_recommendation", "tool:web_search"],
      "action_markers": [
        {
          "action": "writer:formal_valuation",
          "phrases": [
            "Buy",
            "Sell",
            "Strong Buy",
            "Strong Sell",
            "Overweight",
            "Underweight",
            "target price",
            "undervalued",
            "overvalued",
            "买入",
            "卖出",
            "强烈推荐",
            "目标价",
            "低估",
            "高估",
            "正式估值",
            "投资建议"
          ]
        },
        {
          "action": "final_judge:investment_recommendation",
          "phrases": [
            "Buy",
            "Sell",
            "Strong Buy",
            "Strong Sell",
            "Overweight",
            "Underweight",
            "target price",
            "undervalued",
            "overvalued",
            "买入",
            "卖出",
            "强烈推荐",
            "目标价",
            "低估",
            "高估",
            "正式估值",
            "投资建议"
          ]
        }
      ],
      "rules": [
        {
          "id": "formal_valuation_blocks_recommendation",
          "trigger_targets": ["decision:formal_valuation", "gate:data_gate"],
          "blocked_actions": ["writer:formal_valuation", "final_judge:investment_recommendation"]
        },
        {
          "id": "report_publication_blocks_writer",
          "trigger_targets": ["decision:report_publication", "gate:data_gate"],
          "blocked_actions": ["writer:publish_report", "final_judge:publish_report"]
        },
        {
          "id": "wrds_source_policy_blocks_web_tools",
          "trigger_targets": ["tool:web_search", "tool:provider_web_search", "tool:fetch_url", "tool:approved_source_fetch", "constraint:data_source_policy"],
          "blocked_actions": ["tool:web_search", "tool:provider_web_search", "tool:fetch_url", "tool:approved_source_fetch"]
        }
      ]
    },
    "recovery_protocols": [
      {
        "recovery_id": "data_gate_recovery",
        "trigger_targets": ["decision:formal_valuation", "gate:data_gate", "evidence:financial_metrics"],
        "trigger_signal_types": ["risk", "stop_signal", "data_contract"],
        "max_rounds": 3,
        "allowed_agent_roles": ["data_auditor", "quant_research", "wrds_agent"],
        "allowed_capability_tags": ["investment.research", "financial-data"],
        "required_tools": ["wrds_company_financials"],
        "recovery_success_condition": "data_gate.formal_valuation_allowed == true",
        "recovery_failure_candidate": "candidate:investment:insufficient_data",
        "evidence_requirements": {"metric_registry_required": true}
      }
    ],
    "agent_selection_policy": {
      "target_affinity_weights": {
        "decision:formal_valuation": 0.4,
        "gate:data_gate": 0.35,
        "evidence:financial_metrics": 0.25
      },
      "required_roles": ["data_auditor", "quant_research"],
      "optional_roles": ["fundamental_research", "industry_strategy", "risk_manager", "red_team", "cio"],
      "activation_threshold": 0.5,
      "utility_weights": {"quorum_weight": 0.3, "target_match": 0.4, "trust": 0.3},
      "fallback_strategy": "protocol_then_legacy"
    },
    "evidence_policy": {
      "claim_types": ["investment_decision", "valuation_claim", "risk_claim", "metric_claim"],
      "evidence_node_types": ["metric", "claim", "output_permission"],
      "required_evidence_for_final_claims": ["evidence:financial_metrics", "gate:data_gate"],
      "allow_caveated_claim_without_evidence": true,
      "source_independence_required": true,
      "citation_required": false,
      "raw_data_allowed_in_final": false,
      "raw_data_markers": [
        "gvkey",
        "datadate",
        "indfmt",
        "datafmt",
        "popsrc",
        "consol",
        "sale=",
        "cogs=",
        "oancf=",
        "raw row",
        "raw_rows",
        "source_rows"
      ],
      "unsupported_claim_action": "block"
    },
    "tool_policy": {
      "allowed_tool_targets": [
        "tool:wrds_status",
        "tool:wrds_list_libraries",
        "tool:wrds_list_tables",
        "tool:wrds_describe_table",
        "tool:wrds_capability_discovery",
        "tool:wrds_query",
        "tool:wrds_company_search",
        "tool:wrds_company_financials"
      ],
      "blocked_tool_targets": ["tool:web_search", "tool:provider_web_search", "tool:fetch_url", "tool:approved_source_fetch"],
      "source_policy_blocked_tool_targets": ["tool:web_search", "tool:provider_web_search", "tool:fetch_url", "tool:approved_source_fetch"],
      "source_mode": "WRDS_ONLY",
      "source_mode_guidance": "Source mode is {source_mode}: do not include blocked public-web or source-fetch tools{blocked_tools_clause}; use capability-approved source tools only.",
      "source_policy_block_message": "{action} is blocked by declared {source_mode} source policy.",
      "source_policy_constraint_message": "Declared {source_mode} source policy requires the WRDS/metric-registry path; public-web tools are blocked unless explicitly allowed.",
      "required_permissions": ["data:read"],
      "required_connections": ["wrds"],
      "risk_level": "low",
      "quarantine_external_outputs": true,
      "tool_failure_recovery": {"default_recovery_protocol": "data_gate_recovery"}
    },
    "output_policy": {
      "allowed_output_modes": ["gaap_preliminary_view", "wrds_only_preliminary_report", "defect_memo"],
      "blocked_phrases": ["SEC/company verified", "high confidence formal valuation", "officially reconciled"],
      "required_caveats": ["WRDS-only preliminary view"],
      "committed_candidate_conflicts": [
        {
          "candidate": "candidate:investment:insufficient_data",
          "label": "Insufficient Data",
          "blocked_phrases": ["Buy", "Sell", "target price", "目标价", "买入", "卖出", "正式估值"]
        }
      ],
      "final_claim_evidence_required": true,
      "defect_memo_on_block": true,
      "defect_memo_markers": ["Data Readiness Defect Report", "Data Defect Report", "WRDS-only Claim Guardrail Report", "不可发布", "defect memo", "defect report"],
      "writer_can_create_facts": false,
      "final_judge_required_checks": ["committed_candidate", "evidence_graph_consistency", "required_caveats", "raw_data_absence"]
    },
    "swarm_loop_policy": {
      "max_rounds": 3,
      "target_pressure_threshold": 0.5,
      "evidence_gap_threshold": 0.5,
      "recovery_rounds": 1,
      "quorum_check_frequency": 1,
      "stop_signal_check_frequency": 1,
      "tool_health_check_frequency": 1,
      "arousal_signal_template": "Declared arousal level {arousal_level} is {status}; raise verifier strictness to {verifier_strictness}.",
      "social_immunity_arousal_signal_template": "Declared social-immunity status {status} at arousal {arousal_level}; apply verifier quarantine policy.",
      "social_immunity_recommendations": {
        "quarantine_required": "Quarantine contaminated artifacts and require verifier-only handling.",
        "heightened": "Raise verifier strictness and keep writer confidence conservative.",
        "clear": "Maintain normal verification intensity."
      },
      "homeostasis_signal_template": "Declared homeostasis status {status}; apply {recommendation_count} stability recommendation(s).",
      "homeostasis_recommendations": {
        "risk_pressure": "Increase verifier and red-team strictness.",
        "verification_backlog": "Recruit evidence receivers before producing more narrative.",
        "tool_failure_rate": "Deprioritize failing tool routes.",
        "token_heat": "Compress agent outputs before final synthesis.",
        "crowding": "Split work into lanes or suppress low-demand agents.",
        "default": "Maintain current swarm balance."
      },
      "lane_policy": {
        "lanes": ["inspection", "execution", "verification", "synthesis", "control"],
        "preferred_lanes": {
          "writer": "synthesis",
          "final_judge": "control"
        },
        "term_lane_preferences": [
          {"lane": "control", "terms": ["control", "chair"]},
          {"lane": "verification", "terms": ["verification", "verifier", "evidence", "audit", "auditor", "risk"]}
        ],
        "fallback_order": ["synthesis", "inspection", "control", "verification"],
        "default_lane": "inspection",
        "assignment_signal_template": "Declared lane assignment: {agent} -> {lane}."
      },
      "maturity_policy": {
        "maturity_order": ["observer", "worker", "specialist", "verifier", "blocker"],
        "trust_defaults": {
          "core_system": "worker",
          "trusted_first_party": "worker"
        },
        "default_maturity": "observer",
        "demotion_rules": [
          {"metric": "constraint_violation_rate", "operator": ">", "value": 0.05, "maturity": "worker"},
          {"metric": "rejected_signal_rate", "operator": ">", "value": 0.15, "maturity": "worker"}
        ],
        "promotion_rules": [
          {
            "maturity": "blocker",
            "min_total_runs": 20,
            "min_reliability": 0.85,
            "min_verified_signal_count": 10,
            "min_accepted_quorum_participation": 5,
            "requires_can_emit_blocking": true,
            "allowed_trust_levels": ["core_system", "trusted_first_party"]
          },
          {
            "maturity": "verifier",
            "min_total_runs": 10,
            "min_reliability": 0.78,
            "min_verified_signal_count": 5
          },
          {
            "maturity": "specialist",
            "min_total_runs": 3,
            "min_reliability": 0.68,
            "min_accepted_quorum_participation": 1
          }
        ],
        "actions": {
          "observer": ["read_trace", "emit_unverified_signal"],
          "worker": ["emit_unverified_signal", "perform_low_risk_task"],
          "specialist": ["emit_unverified_signal", "participate_quorum"],
          "verifier": ["participate_quorum", "verify_limited_evidence"],
          "blocker": ["participate_quorum", "propose_blocking_signal"]
        },
        "signal_template": "Declared maturity for {agent}: {maturity}."
      },
      "independent_scout_policy": {
        "source_family_rules": [
          {"family": "risk", "terms": ["risk", "red_team"]},
          {"family": "data", "terms": ["data", "quant"]},
          {"family": "analyst", "terms": ["fundamental", "industry"]},
          {"family": "market", "terms": ["market"]}
        ],
        "default_source_family": "agent",
        "min_independence_score": 0.5,
        "force_fallback_when_low_independence": true,
        "signal_template": "Declared independent scout diversity is {source_diversity}.",
        "low_independence_reason_template": "Declared source diversity below quorum policy threshold.",
        "forced_fallback_reason_template": "Declared low independent support diversity; forced {fallback_label}."
      },
      "controller_action_policy": {
        "default_action_target": "swarm:scheduling",
        "default_action_reason": "Declared swarm controller action.",
        "default_bottleneck_reason": "Declared bottleneck detected.",
        "default_lane_violation_reason": "Declared lane violation.",
        "runtime_budget_default_recommendation": "Maintain declared activation budget.",
        "runtime_budget_target": "swarm:runtime_budget",
        "low_return_reason": "Declared low verified return rate.",
        "verification_policy_reason": "Declared arousal and gate pressure policy.",
        "arousal_verification_target": "agent:verifier_and_final_judge",
        "arousal_verification_reason": "Declared arousal policy requested stricter checks.",
        "quorum_policy_signal_template": "Declared swarm controller updated quorum policy at independence {min_independence_score}.",
        "homeostasis_action_rules": [
          {
            "action": "prioritize_evidence_receivers",
            "target": "swarm:evidence_receivers",
            "terms": ["recruit evidence"]
          },
          {
            "action": "compress_before_synthesis",
            "target": "agent:writer",
            "terms": ["compress"]
          },
          {
            "action": "reduce_crowding",
            "target": "swarm:scheduling",
            "terms": ["suppress", "split work"]
          }
        ]
      },
      "tool_health_recommendations": {
        "failing": "Block or reroute failing WRDS/model paths before report publication.",
        "degraded": "Lower confidence and prefer deterministic WRDS/metric-registry routes.",
        "healthy": "Maintain current governed tool route.",
        "no_tool_activity": "Maintain current governed tool route."
      },
      "encounter_rate_recommendations": {
        "healthy": "Maintain or expand current governed lanes.",
        "degraded": "Keep execution conservative and prioritize verifier feedback.",
        "poor": "Reduce expansion and route more work to verification.",
        "insufficient_history": "Collect more local return events before adjusting activation."
      },
      "outcome_feedback_enabled": true
    },
    "required_governance_actors": ["data_gate", "quorum_marshal", "protocol_police", "writer", "final_judge"]
  },
  "swarm": {
    "required_protocols": ["data_gate", "quorum", "stop_signal"],
    "targets": [
