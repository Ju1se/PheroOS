{
  "id": "web-research",
  "name": "Public Web Research",
  "version": "0.1.0",
  "description": "Research public web sources safely with source attribution for non-investment tasks.",
  "capability_types": ["public_web_research", "skill:web-research"],
  "permissions": ["network:approved-provider", "data:read", "skill:read"],
  "risk_level": "low",
  "trust_level": "first_party_reviewed",
  "sandbox": {
    "network": "approved_provider_only",
    "filesystem": "read_only",
    "secrets": "no_direct_access",
    "model_calls": "gateway_only",
    "tools": "registry_only"
  },
  "allowed_imports": [],
  "network_allowlist": [],
  "signature": {"status": "unsigned"},
  "requires_confirmation": false,
  "connections": [],
  "tools": ["web_search", "fetch_url", "approved_source_fetch", "provider_web_search"],
  "skills": ["web-research"],
  "data_packages": [],
  "entrypoints": {
    "workflow": "workflow.py:build_workflow_descriptor"
  },
  "protocol": {
    "version": "1.0.0",
    "intents": ["web_research"],
    "intent_keywords": {
      "web_research": [
        "web research",
        "search the web",
        "look up",
        "latest",
        "current",
        "news",
        "official",
        "source",
        "documentation",
        "public web",
        "联网",
        "搜索",
        "查询",
        "网上",
        "网页",
        "新闻",
        "动态",
        "官网",
        "官方",
        "来源",
        "引用",
        "资料"
      ]
    },
    "required_capability_types": ["public_web_research", "skill:web-research"],
    "targets": [
      {
        "target": "research:source_retrieval",
        "aliases": ["source_retrieval", "source_candidates"],
        "target_type": "research",
        "default_pressure": 0.82,
        "keywords": ["source", "retrieval", "coverage", "web"],
        "description": "Retrieve public web source candidates."
      },
      {
        "target": "metric:research_source_quality",
        "aliases": ["research:source_quality", "source_quality"],
        "target_type": "metric",
        "default_pressure": 0.74,
        "keywords": ["source_quality", "provenance", "authority"],
        "description": "Rate public source quality."
      },
      {
        "target": "gate:research_evidence_gate",
        "aliases": ["research:evidence_gate", "evidence_gate", "claim_support"],
        "target_type": "gate",
        "default_pressure": 0.68,
        "keywords": ["evidence", "support"],
        "description": "Keep findings evidence-linked."
      }
    ],
    "recovery_protocols": [
      {
        "recovery_id": "public_web_approved_source_recovery",
        "trigger_targets": ["research:source_retrieval"],
        "max_rounds": 2,
        "required_tools": ["approved_source_fetch"],
        "recovery_success_condition": "context.source_count > 0",
        "recovery_failure_candidate": "candidate:web:insufficient_sources",
        "recruitment": "target_pressure"
      }
    ],
    "candidates": [
      {
        "candidate": "candidate:web:sourced_answer",
        "label": "Sourced answer",
        "target": "research:source_retrieval",
        "required_evidence_targets": ["gate:research_evidence_gate"]
      },
      {
        "candidate": "candidate:web:preliminary",
        "label": "Preliminary",
        "target": "research:source_retrieval",
        "required_evidence_targets": ["gate:research_evidence_gate"]
      },
      {
        "candidate": "candidate:web:insufficient_sources",
        "label": "Insufficient sources",
        "target": "research:source_retrieval",
        "safe_fallback": true
      }
    ],
    "quorum_policy": {
      "candidate_type": "web_research_synthesis",
      "candidates": ["candidate:web:sourced_answer", "candidate:web:preliminary", "candidate:web:insufficient_sources"],
      "candidate_fallback": "candidate:web:insufficient_sources",
      "evidence_coverage_weight": 0.5,
      "source_independence_weight": 0.25,
      "max_swarm_rounds": 2
    },
    "evidence_policy": {
      "claim_types": ["public_web_research_claim"],
      "evidence_node_types": ["public_web_source", "approved_source_fetch"],
      "required_evidence_for_final_claims": ["gate:research_evidence_gate"],
      "allow_caveated_claim_without_evidence": false,
      "source_independence_required": true,
      "citation_required": true,
      "raw_data_allowed_in_final": false,
      "unsupported_claim_action": "block"
    },
    "tool_policy": {
      "allowed_tool_targets": ["tool:web_search", "tool:fetch_url", "tool:approved_source_fetch", "tool:provider_web_search"],
      "required_permissions": ["network:approved-provider", "data:read", "skill:read"],
      "risk_level": "low",
      "quarantine_external_outputs": true,
      "tool_failure_recovery": {
        "web_search": "public_web_approved_source_recovery",
        "fetch_url": "public_web_approved_source_recovery"
      }
    },
    "output_policy": {
      "allowed_output_modes": ["sourced_answer", "preliminary_with_caveats", "insufficient_sources"],
      "required_caveats": ["State source limitations when evidence coverage is incomplete."],
      "final_claim_evidence_required": true,
      "defect_memo_on_block": true,
      "writer_can_create_facts": false
    },
    "stop_signal_policy": {
      "authority_level_required": 3,
      "blocking_lifetime": "until_resolved",
      "blocked_actions": ["writer:unsourced_claim"],
      "rules": [
        {
          "id": "evidence_gate_blocks_unsourced_claim",
          "trigger_targets": ["gate:research_evidence_gate"],
          "blocked_actions": ["writer:unsourced_claim"]
        }
      ]
    }
  },
  "ui": {
    "icon": "globe",
    "accent": "cyan"
  }
}
