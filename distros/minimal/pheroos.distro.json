{
  "schema_version": "pheroos.distro.v0.1",
  "distro_id": "minimal",
  "name": "PheroOS Minimal",
  "description": "No-key reference distro for toy-review, mock drivers, and local trace storage.",
  "enabled_capabilities": ["toy-review"],
  "drivers": [
    {
      "driver_kind": "model",
      "driver_id": "mock-model",
      "external_api_required": false
    },
    {
      "driver_kind": "tool",
      "driver_id": "mock-lookup",
      "side_effect_class": "read_only",
      "external_api_required": false
    },
    {
      "driver_kind": "storage",
      "driver_id": "local-jsonl-trace",
      "path": ".pheroos/minimal-traces.jsonl"
    }
  ],
  "network_access": "none",
  "secrets_required": []
}
