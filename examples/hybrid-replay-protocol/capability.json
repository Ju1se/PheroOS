{
  "id": "hybrid-replay-protocol",
  "name": "Hybrid Replay Protocol",
  "version": "0.2.0rc1",
  "permissions": [],
  "required_connections": [],
  "drivers": [],
  "protocol": {
    "protocol_version": "pheroos.protocol.v2",
    "id": "swarm.hybrid-replay",
    "targets": [
      {
        "id": "decision:collective",
        "description": "A provider-free durable Hybrid Replay v2 decision target."
      }
    ],
    "signals": [
      {
        "type": "recruitment",
        "target": "decision:collective",
        "authority_required": "governance"
      },
      {
        "type": "inhibition",
        "target": "decision:collective",
        "authority_required": "governance"
      }
    ],
    "candidates": [
      {
        "id": "candidate:alpha",
        "target": "decision:collective",
        "label": "Alpha"
      },
      {
        "id": "candidate:beta",
        "target": "decision:collective",
        "label": "Beta"
      },
      {
        "id": "candidate:safe_fallback",
        "target": "decision:collective",
        "label": "Safe Fallback",
        "safe_fallback": true
      }
    ],
    "quorum_policy": {
      "target": "decision:collective",
      "fallback_candidate": "candidate:safe_fallback",
      "commit_threshold": 2
    },
    "authority_policy": {
      "policy_version": "pheroos-scoped-authority-policy-v2",
      "profile": "pheroos-scoped-authority-local-v2",
      "wire_version": "pheroos-authority-wire-v2",
      "canonical_version": "pheroos-authority-canonical-v2",
      "ledger_version": "pheroos-governance-authority-ledger-v2",
      "state_store_version": "pheroos-governance-state-store-v2",
      "trace_batch_version": "pheroos-governance-trace-batch-v2",
      "read_set_version": "pheroos-governance-authority-read-set-v2"
    },
    "collective_decision_policy": {
      "mode": "hybrid",
      "min_independent_scouts": 2,
      "quorum_threshold": 4,
      "recruitment_enabled": true,
      "inhibition_enabled": true,
      "pheromone_enabled": true,
      "pheromone_evaporation_rate": 0.2,
      "pheromone_decay_model": "exponential",
      "pheromone_min_strength": 0,
      "pheromone_max_strength": 10,
      "pheromone_positive_weight": 1,
      "pheromone_negative_weight": 1,
      "pheromone_cautionary_weight": 1,
      "pheromone_cautionary_override_threshold": 2,
      "pheromone_novelty_weight": 0.5,
      "pheromone_per_source_cap": 4,
      "pheromone_per_round_deposit_cap": 5,
      "pheromone_min_source_diversity": 1,
      "pheromone_require_provenance": true,
      "pheromone_require_trace": true,
      "pheromone_scored_subject_types": [
        "agent",
        "candidate",
        "route",
        "tool"
      ],
      "pheromone_kind_profiles": {
        "positive": {
          "weight": 1,
          "evaporation_rate": 0.2,
          "ttl_steps": 6,
          "response_model": "saturating",
          "priority": 1,
          "scored_subject_types": [
            "agent",
            "candidate",
            "route",
            "tool"
          ]
        },
        "negative": {
          "weight": 1,
          "evaporation_rate": 0.3,
          "ttl_steps": 4,
          "response_model": "linear",
          "priority": 2,
          "scored_subject_types": [
            "candidate",
            "route"
          ]
        },
        "cautionary": {
          "weight": 1.25,
          "evaporation_rate": 0.5,
          "ttl_steps": 2,
          "response_model": "threshold",
          "priority": 3,
          "can_suppress_positive": true,
          "scored_subject_types": [
            "candidate",
            "route"
          ]
        },
        "alarm": {
          "weight": 2,
          "evaporation_rate": 0.8,
          "ttl_steps": 1,
          "response_model": "threshold",
          "priority": 4,
          "can_suppress_positive": true,
          "scored_subject_types": [
            "candidate",
            "route"
          ]
        },
        "novelty": {
          "weight": 0.5,
          "evaporation_rate": 0.6,
          "ttl_steps": 2,
          "response_model": "linear",
          "priority": 1,
          "scored_subject_types": [
            "candidate",
            "route"
          ]
        },
        "stale": {
          "weight": 0,
          "priority": 0
        }
      },
      "pheromone_response_model": "saturating",
      "pheromone_activation_threshold": 0.5,
      "pheromone_saturation_threshold": 4,
      "pheromone_competition_mode": "normalize",
      "pheromone_exploration_floor": 0.1,
      "pheromone_diffusion_enabled": true,
      "pheromone_diffusion_max_hops": 1,
      "pheromone_diffusion_attenuation": 0.5,
      "pheromone_feedback_enabled": true,
      "exploration_enabled": true,
      "exploration_floor": 0.1,
      "novelty_decay_rate": 0.6,
      "stale_route_reopen_threshold": 0.2,
      "layer_coordination_enabled": true,
      "layer_weight_bounds": {
        "reactive": [
          0,
          1.5
        ],
        "learned": [
          0,
          1.5
        ],
        "evolutionary": [
          0,
          1
        ],
        "metacognitive": [
          0,
          1
        ]
      },
      "layer_default_weights": {
        "reactive": 1,
        "learned": 1,
        "evolutionary": 0.5,
        "metacognitive": 0.5
      },
      "layer_confidence_thresholds": {
        "reactive": 0.6,
        "learned": 0.6,
        "evolutionary": 0.6,
        "metacognitive": 0.6
      },
      "layer_conflict_threshold": 0.1,
      "layer_emergency_override_threshold": 0.8,
      "layer_min_provenance": 2,
      "layer_fallback_on_unresolved_conflict": true,
      "policy_adjustment_bounds": {
        "pheromone_evaporation_rate": [
          0.1,
          0.5
        ],
        "pheromone_positive_weight": [
          0.5,
          2
        ],
        "pheromone_response_model": {
          "allowed_values": [
            "competitive",
            "linear",
            "saturating",
            "threshold"
          ]
        },
        "pheromone_exploration_floor": [
          0,
          1
        ],
        "layer_learned_weight": [
          0,
          1.5
        ]
      },
      "fallback_candidate": "candidate:safe_fallback"
    },
    "recovery_protocols": [
      {
        "id": "recovery:hybrid_conflict",
        "trigger_targets": [
          "decision:collective"
        ],
        "allowed_roles": [
          "reviewer"
        ],
        "allowed_tags": [
          "hybrid",
          "swarm"
        ],
        "required_tools": [],
        "failure_candidate": "candidate:safe_fallback"
      }
    ],
    "evidence_policy": {
      "require_provenance": true,
      "allow_agent_fact_creation": false
    },
    "output_policy": {
      "policy_version": "pheroos-baseline-output-policy-v2",
      "decision_mode": "quorum",
      "actions": [
        {
          "action_ref": "action:publish-collective",
          "effect": "publish",
          "target": "decision:collective",
          "allowed_outcomes": [
            "evidence_commit",
            "safe_fallback"
          ]
        }
      ]
    },
    "trace_policy": {
      "required_events": [
        "baseline_action_permission_issued",
        "baseline_decision_evaluated",
        "baseline_evidence_qualified",
        "baseline_manifest_activated",
        "baseline_output_committed",
        "baseline_stop_resolved",
        "block",
        "candidate_score",
        "commit",
        "consensus_check",
        "coordination_assess",
        "coordination_resolve",
        "explore",
        "fallback",
        "inhibit",
        "layer_proposal",
        "output",
        "pheromone_clip",
        "pheromone_deposit",
        "pheromone_diffuse",
        "pheromone_evaporate",
        "pheromone_expire",
        "pheromone_normalize",
        "pheromone_observe",
        "pheromone_reinforce",
        "pheromone_score",
        "policy_adjustment",
        "recovery",
        "recruit",
        "scout_report"
      ]
    }
  }
}
