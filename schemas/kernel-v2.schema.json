{
  "$id": "https://pheroos.dev/schemas/kernel-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_resolutions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "capability_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "capability_id",
          "available"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "connection_readiness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "connection": {
            "minLength": 1,
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "connection",
          "available"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "connection_requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "connection": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "capability_id",
          "connection"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "degraded": {
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "driver_exposures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "capability_id": {
            "type": "string"
          },
          "driver_id": {
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "driver_id",
          "capability_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "driver_probe_snapshots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detail": {
            "type": "string"
          },
          "driver_id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "driver_id",
          "available",
          "version",
          "capabilities"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "permission_grants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "granted": {
            "type": "boolean"
          },
          "permission": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "capability_id",
          "permission"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "plan_version": {
      "const": "pheroos-kernel-plan-v2"
    },
    "request_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "runtime_ready": {
      "type": "boolean"
    },
    "scope_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tool_exposures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tool_id": {
            "type": "string"
          }
        },
        "required": [
          "tool_id",
          "capability_id"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "plan_version",
    "tenant_id",
    "request_id",
    "run_id",
    "scope_ref",
    "capability_resolutions",
    "permission_grants",
    "connection_requirements",
    "connection_readiness",
    "driver_probe_snapshots",
    "driver_exposures",
    "tool_exposures",
    "diagnostics",
    "runtime_ready",
    "degraded"
  ],
  "type": "object"
}
