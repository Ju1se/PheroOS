{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pheroos.dev/pheroos.capability.v0.1.schema.json",
  "title": "PheroOS Capability Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "capability_types",
    "permissions",
    "risk_level"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capability_types": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high"]},
    "required_connections": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "entrypoints": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "data_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/data_source"}
    },
    "protocol": {"$ref": "pheroos.protocol.v0.1.schema.json"}
  },
  "$defs": {
    "data_source": {
      "type": "object",
      "required": ["provider_id", "source_kind", "dataset_kind"],
      "additionalProperties": true,
      "properties": {
        "provider_id": {"type": "string"},
        "source_kind": {"type": "string"},
        "dataset_kind": {"type": "string"},
        "normalized_result_schema": {"type": "string"},
        "coverage": {"type": "object"},
        "freshness": {"type": "object"},
        "license": {"type": "object"},
        "adapter_entrypoint": {"type": "string"},
        "provenance_policy": {"type": "object"}
      }
    }
  }
}
