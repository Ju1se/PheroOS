{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pheroos.dev/pheroos.evidence.v0.1.schema.json",
  "title": "PheroOS Evidence Node",
  "type": "object",
  "required": ["evidence_id", "target", "source_kind", "provenance"],
  "additionalProperties": true,
  "properties": {
    "evidence_id": {"type": "string"},
    "target": {"type": "string"},
    "claim": {"type": "string"},
    "source_kind": {"type": "string"},
    "source_quality": {"type": "string"},
    "supporting": {"type": "boolean"},
    "challenging": {"type": "boolean"},
    "independence_group": {"type": "string"},
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "citations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "raw_data_allowed_in_final": {"type": "boolean"}
  }
}
