{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pheroos.dev/pheroos.signal.v0.1.schema.json",
  "title": "PheroOS Signal",
  "type": "object",
  "required": ["run_id", "type", "target", "content", "verification_state"],
  "additionalProperties": true,
  "properties": {
    "run_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "type": {"type": "string"},
    "target": {"type": "string"},
    "content": {"type": "string"},
    "strength": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decay_rate": {"type": "number", "minimum": 0},
    "priority": {"type": "string"},
    "scope": {"type": "string"},
    "verification_state": {
      "type": "string",
      "enum": ["unverified", "verified", "contested", "rejected", "blocking"]
    },
    "source_agent": {"type": "string"},
    "source_module": {"type": "string"},
    "evidence_ref": {"type": "string"},
    "blocking": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}
