{
  "$id": "https://pheroos.dev/schemas/protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^(x-|ext\\.).+": {}
  },
  "properties": {
    "candidates": {
      "items": {
        "additionalProperties": false,
        "patternProperties": {
          "^(x-|ext\\.).+": {}
        },
        "properties": {
          "extensions": {
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "safe_fallback": {
            "type": "boolean"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "collective_decision_policy": {
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|ext\\.).+": {}
      },
      "properties": {
        "exploration_enabled": {
          "type": "boolean"
        },
        "exploration_floor": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "extensions": {
          "type": "object"
        },
        "fallback_candidate": {
          "type": "string"
        },
        "inhibition_enabled": {
          "type": "boolean"
        },
        "layer_confidence_thresholds": {
          "additionalProperties": false,
          "patternProperties": {
            "^(reactive|learned|evolutionary|metacognitive)$": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "layer_conflict_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "layer_coordination_enabled": {
          "type": "boolean"
        },
        "layer_default_weights": {
          "additionalProperties": false,
          "patternProperties": {
            "^(reactive|learned|evolutionary|metacognitive)$": {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "layer_emergency_override_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "layer_fallback_on_unresolved_conflict": {
          "type": "boolean"
        },
        "layer_min_provenance": {
          "minimum": 1,
          "type": "integer"
        },
        "layer_weight_bounds": {
          "additionalProperties": false,
          "patternProperties": {
            "^(reactive|learned|evolutionary|metacognitive)$": {
              "oneOf": [
                {
                  "items": {
                    "maximum": 10,
                    "minimum": 0,
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                {
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(x-|ext\\.).+": {}
                  },
                  "properties": {
                    "max": {
                      "maximum": 10,
                      "minimum": 0,
                      "type": "number"
                    },
                    "min": {
                      "maximum": 10,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "type": "object"
        },
        "min_independent_scouts": {
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "quorum",
            "bee_swarm",
            "ant_colony",
            "hybrid"
          ]
        },
        "novelty_decay_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "pheromone_activation_threshold": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_cautionary_override_threshold": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_cautionary_weight": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_competition_mode": {
          "enum": [
            "none",
            "normalize"
          ]
        },
        "pheromone_decay_model": {
          "enum": [
            "linear",
            "exponential",
            "step"
          ]
        },
        "pheromone_diffusion_attenuation": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "pheromone_diffusion_enabled": {
          "type": "boolean"
        },
        "pheromone_diffusion_max_hops": {
          "minimum": 0,
          "type": "integer"
        },
        "pheromone_enabled": {
          "type": "boolean"
        },
        "pheromone_evaporation_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "pheromone_exploration_floor": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "pheromone_feedback_enabled": {
          "type": "boolean"
        },
        "pheromone_kind_profiles": {
          "additionalProperties": false,
          "patternProperties": {
            "^(positive|negative|cautionary|alarm|novelty|stale)$": {
              "additionalProperties": false,
              "patternProperties": {
                "^(x-|ext\\.).+": {}
              },
              "properties": {
                "can_suppress_positive": {
                  "type": "boolean"
                },
                "evaporation_rate": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "extensions": {
                  "type": "object"
                },
                "priority": {
                  "minimum": 0,
                  "type": "integer"
                },
                "response_model": {
                  "enum": [
                    "linear",
                    "saturating",
                    "threshold",
                    "competitive"
                  ]
                },
                "scored_subject_types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "ttl_steps": {
                  "minimum": 0,
                  "type": "integer"
                },
                "weight": {
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [],
              "type": "object"
            },
            "^(x-|ext\\.).+": {
              "additionalProperties": false,
              "patternProperties": {
                "^(x-|ext\\.).+": {}
              },
              "properties": {
                "can_suppress_positive": {
                  "type": "boolean"
                },
                "evaporation_rate": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "extensions": {
                  "type": "object"
                },
                "priority": {
                  "minimum": 0,
                  "type": "integer"
                },
                "response_model": {
                  "enum": [
                    "linear",
                    "saturating",
                    "threshold",
                    "competitive"
                  ]
                },
                "scored_subject_types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "ttl_steps": {
                  "minimum": 0,
                  "type": "integer"
                },
                "weight": {
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "type": "object"
        },
        "pheromone_max_strength": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_min_source_diversity": {
          "minimum": 1,
          "type": "integer"
        },
        "pheromone_min_strength": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_negative_weight": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_novelty_weight": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_per_round_deposit_cap": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_per_source_cap": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_positive_weight": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_require_provenance": {
          "type": "boolean"
        },
        "pheromone_require_trace": {
          "type": "boolean"
        },
        "pheromone_response_model": {
          "enum": [
            "linear",
            "saturating",
            "threshold",
            "competitive"
          ]
        },
        "pheromone_saturation_threshold": {
          "minimum": 0,
          "type": "number"
        },
        "pheromone_scored_subject_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "policy_adjustment_bounds": {
          "additionalProperties": false,
          "patternProperties": {
            "^(pheromone_evaporation_rate|pheromone_exploration_floor|layer_emergency_override_threshold)$": {
              "oneOf": [
                {
                  "items": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                {
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(x-|ext\\.).+": {}
                  },
                  "properties": {
                    "max": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "min": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "type": "object"
                }
              ]
            },
            "^(pheromone_positive_weight|pheromone_negative_weight|pheromone_cautionary_weight|pheromone_alarm_weight|pheromone_novelty_weight|pheromone_cautionary_override_threshold|layer_learned_weight|layer_evolutionary_weight|layer_metacognitive_weight)$": {
              "oneOf": [
                {
                  "items": {
                    "maximum": 10,
                    "minimum": 0,
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                {
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(x-|ext\\.).+": {}
                  },
                  "properties": {
                    "max": {
                      "maximum": 10,
                      "minimum": 0,
                      "type": "number"
                    },
                    "min": {
                      "maximum": 10,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "type": "object"
                }
              ]
            },
            "^pheromone_response_model$": {
              "additionalProperties": false,
              "patternProperties": {
                "^(x-|ext\\.).+": {}
              },
              "properties": {
                "allowed_values": {
                  "items": {
                    "enum": [
                      "linear",
                      "saturating",
                      "threshold",
                      "competitive"
                    ]
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "allowed_values"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "quorum_threshold": {
          "minimum": 1,
          "type": "integer"
        },
        "recruitment_enabled": {
          "type": "boolean"
        },
        "stale_route_reopen_threshold": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [],
      "type": "object"
    },
    "evidence_policy": {
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|ext\\.).+": {}
      },
      "properties": {
        "allow_agent_fact_creation": {
          "type": "boolean"
        },
        "extensions": {
          "type": "object"
        },
        "require_provenance": {
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "output_policy": {
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|ext\\.).+": {}
      },
      "properties": {
        "extensions": {
          "type": "object"
        },
        "requires_committed_candidate": {
          "const": true,
          "type": "boolean"
        },
        "requires_evidence_contract": {
          "const": true,
          "type": "boolean"
        },
        "requires_publication_permission": {
          "const": true,
          "type": "boolean"
        },
        "requires_stop_resolution": {
          "const": true,
          "type": "boolean"
        },
        "writer_may_create_facts": {
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "protocol_version": {
      "type": "string"
    },
    "quorum_policy": {
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|ext\\.).+": {}
      },
      "properties": {
        "commit_threshold": {
          "minimum": 1,
          "type": "integer"
        },
        "extensions": {
          "type": "object"
        },
        "fallback_candidate": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "fallback_candidate"
      ],
      "type": "object"
    },
    "recovery_protocols": {
      "items": {
        "additionalProperties": false,
        "patternProperties": {
          "^(x-|ext\\.).+": {}
        },
        "properties": {
          "allowed_roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowed_tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "extensions": {
            "type": "object"
          },
          "failure_candidate": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "required_tools": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "trigger_targets": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "trigger_targets"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "signals": {
      "items": {
        "additionalProperties": false,
        "patternProperties": {
          "^(x-|ext\\.).+": {}
        },
        "properties": {
          "authority_required": {
            "type": "string"
          },
          "extensions": {
            "type": "object"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "patternProperties": {
          "^(x-|ext\\.).+": {}
        },
        "properties": {
          "description": {
            "type": "string"
          },
          "extensions": {
            "type": "object"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "trace_policy": {
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|ext\\.).+": {}
      },
      "properties": {
        "extensions": {
          "type": "object"
        },
        "required_events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "id",
    "targets",
    "candidates",
    "quorum_policy",
    "output_policy",
    "trace_policy"
  ],
  "type": "object"
}
